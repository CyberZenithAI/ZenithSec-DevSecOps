{
    "powershell.scriptAnalysis.enable": true,
    "powershell.scriptAnalysis.settingsPath": "${workspaceFolder}/security/PSScriptAnalyzerSettings.psd1",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-vscode.powershell",
    "files.associations": {
        "*.json": "json",
        "*.yml": "yaml",
        "*.ps1": "powershell",
        "*.psm1": "powershell",
        "*.psd1": "powershell"
    },
    "security.workspace.trust.enabled": true,
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true
    }
}
