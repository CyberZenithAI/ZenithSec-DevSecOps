{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PowerShell: Debug Current Script",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "PowerShell: Run Pester Tests",
            "type": "PowerShell",
            "request": "launch",
            "script": "Invoke-Pester -Path '${workspaceFolder}/tests' -Output Detailed",
            "cwd": "${workspaceFolder}"
        }
    ]
}
